<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_ayuda"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/metro_fondo"
    tools:context=".Ayuda">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Ayuda del Conversor de Unidades"
            android:textColor="#0000ff"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="1. Uso de la aplicación"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="• Selecciona en el desplegable superior el tipo de conversión y el sentido deseado.\n• Introduce el valor numérico en el campo de texto.\n• Pulsa el botón Convertir para obtener el resultado redondeado a dos decimales."
            android:textColor="#212121"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="2. Conversiones disponibles"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="• Longitud corta: Pulgadas ↔ Centímetros\n• Distancia: Kilómetros ↔ Millas\n• Masa / Peso: Kilogramos ↔ Libras"
            android:textColor="#212121"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="3. Mensajes de error"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="• El valor no puede estar vacío: Se muestra si pulsas Convertir sin escribir ninguna cantidad.\n• Formato numérico no válido: Se muestra si se introducen caracteres no numéricos.\n• Sólo números >=1: Se muestra si el número introducido es menor que 1."
            android:textColor="#212121"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_Volver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:text="Volver" />

    </LinearLayout>
</ScrollView>